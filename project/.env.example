# =============================================================
# VAIVAHIK MANCH - AWS S3 STORAGE CONFIGURATION
# =============================================================
USE_S3=True

# AWS IAM User Access Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS S3 Bucket Name
AWS_STORAGE_BUCKET_NAME=risteybucket

# AWS S3 Region
AWS_S3_REGION_NAME=ap-south-1

# =============================================================
# POSTGRESQL DATABASE CONFIGURATION (EC2 / RDS)
# =============================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=mypassword
# Set to 15.206.88.210 if connecting from remote, or 127.0.0.1 on the EC2 server:
DB_HOST=15.206.88.210
DB_PORT=5432
